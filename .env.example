# Public env vars consumed by the Next.js client prefixed with NEXT_PUBLIC_*.
# Values shown are for LOCAL development (anonymous Convex backend).
# See README.md for how to wire these to the production Convex/Vercel deploy.

# --- Convex backend ---
# For local: keep anonymous.
CONVEX_DEPLOYMENT=anonymous:anonymous-my-personal-website
# For production (Vercel): set the deployment name, e.g. wonderful-pony-433
# NEXT_PUBLIC_CONVEX_URL = the Convex CLIENT URL — must end with
#   .convex.cloud (do NOT use .convex.site, that domain is for HTTP Actions).
#   Local value uses the anonymous dev backend.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Site URL used for HTTP Actions / auth redirects (.convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# --- Site metadata (used for email links / footer) ---
NEXT_PUBLIC_SITE_EMAIL=homfay.work@gmail.com
NEXT_PUBLIC_SITE_GITHUB=https://github.com/Homfay-0903